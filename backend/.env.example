# ─────────────────────────────────────────────────────────────────────────────
# SA Smart Wallet – USSD Backend  |  Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Network ─────────────────────────────────────────────────────────────────
# Sepolia RPC endpoint (Alchemy, Infura, QuickNode, etc.)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ERC-4337 Bundler endpoint for Sepolia (Pimlico, Alchemy, Stackup)
BUNDLER_RPC_URL=https://api.stackup.sh/v1/node/YOUR_KEY

# ─── Contract Addresses ───────────────────────────────────────────────────────
# Copy these from the output of: npx hardhat run scripts/deploy.js --network sepolia
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
FACTORY_ADDRESS=
PAYMASTER_ADDRESS=
ZAR_TOKEN_ADDRESS=

# ─── Backend Signing Keys ─────────────────────────────────────────────────────
# The paymaster's signing key – MUST match verifyingSigner set during deployment.
# In production this lives in an HSM/KMS (e.g. AWS KMS, Google Cloud KMS).
PAYMASTER_SIGNER_PRIVATE_KEY=your_paymaster_signer_private_key_here

# A per-user key encryption secret – used to encrypt/decrypt user private keys
# stored in the local DB.  Must be a 32-byte hex string (64 hex characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=your_64_char_hex_secret_here

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=3000

# JWT secret for signing session tokens – generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here

# ─── ZAKA: SMS via Africa's Talking ──────────────────────────────────────────
# Without AT_USERNAME + AT_API_KEY, SMS are logged as "simulated" (the web
# simulator still shows them on the phones). AT_USERNAME=sandbox uses the AT sandbox.
# AT_USERNAME=sandbox
# AT_API_KEY=your_africas_talking_api_key
# Short code SMS are sent from (the "from" field):
# SHORT_CODE=12345
# Optional premium SMS settings:
# AT_SMS_KEYWORD=
# AT_SMS_BULK_MODE=0
# AT_SMS_RETRY_HOURS=

# ─── ZAKA: tiered KYC limits (whole Rands) ───────────────────────────────────
# Level 0 = ID number captured on USSD, Level 1 = validated at a merchant / website
# KYC_L0_DAILY_LIMIT=500
# KYC_L0_MONTHLY_LIMIT=10000
# KYC_L1_DAILY_LIMIT=25000
# KYC_L1_MONTHLY_LIMIT=100000

# Protects POST /api/kyc/:phone/verify, /api/kyc/:phone/id and /api/sms/send
# (callers send the header  x-admin-key: <value>). Leave empty only for local dev.
# ADMIN_API_KEY=

# Optional: also record Level 1 approvals on the on-chain FICARegistry (costs gas)
# FICA_SYNC=false
# FICA_REGISTRY_ADDRESS=
# FICA_OPERATOR_PRIVATE_KEY=
