# ─────────────────────────────────────────────────────────────────────────────
# Smart Wallet Factory – South Africa  |  Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Sepolia RPC endpoint (Alchemy, Infura, QuickNode, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Etherscan API key – used by hardhat-etherscan to verify contracts
ETHERSCAN_API_KEY=your_etherscan_api_key

# ─── Paymaster signer ────────────────────────────────────────────────────────
# The private key of the off-chain signer that authorises UserOperations for
# the ZARPaymaster.  In production this lives in a secure HSM / KMS.
PAYMASTER_SIGNER_PRIVATE_KEY=paymaster_signer_private_key_here

# ─── Bundler ─────────────────────────────────────────────────────────────────
# Public ERC-4337 bundler endpoint for Sepolia (e.g. Alchemy, Pimlico, Stackup)
BUNDLER_RPC_URL=https://api.stackup.sh/v1/node/YOUR_KEY

# ─── Optional: gas reporter ──────────────────────────────────────────────────
REPORT_GAS=false

